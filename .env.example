# .env.local dosyasına kopyala ve doldur. .env.local commit edilmez.

# İstemci yapılandırması (gizli değildir, tarayıcıya gider)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Yerelde Emulator kullanmak için true
NEXT_PUBLIC_USE_EMULATOR=false

# Yalnızca sunucu: servis hesabı JSON'u tek satır olarak
FIREBASE_SERVICE_ACCOUNT=

# Yalnızca betikler (scripts/ingest). Web uygulamasının ortamına konmaz.
GEMINI_API_KEY=

# Etiketli simülasyon verisini açar
DEMO_MODE=false
