{
  "name": "sau-calisma-asistani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest/index.ts",
    "publish-schedule": "tsx --env-file-if-exists=.env.local scripts/publish/index.ts",
    "emulators": "firebase emulators:start --only firestore,auth",
    "seed-demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo/index.ts",
    "demo:local": "firebase emulators:exec --only firestore,auth --project demo-sau-calisma --ui \"npm run seed-campus && DEMO_MODE=true npm run seed-demo && next dev\"",
    "test:e2e": "playwright test",
    "demo-report": "tsx --env-file-if-exists=.env.local scripts/demo-report/index.ts",
    "seed-campus": "tsx --env-file-if-exists=.env.local scripts/seed-campus/index.ts",
    "qr": "tsx --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/qr/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@google/genai": "^2.31.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "exceljs": "^4.4.0",
    "firebase-tools": "^15.34.1",
    "qrcode": "1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "mapbox-gl": "3.32.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  }
}
