rules_version = '2';

// İstemciden hiçbir koleksiyona yazma yok. Yazmalar Route Handler + Admin SDK ile yapılır
// (Admin SDK bu kuralları atlar; doğrulama src/server içindedir).
service cloud.firestore {
  match /databases/{database}/documents {
    match /terms/{id} { allow read: if true; allow write: if false; }
    match /buildings/{id} { allow read: if true; allow write: if false; }
    match /spaces/{id} { allow read: if true; allow write: if false; }
    match /scheduleBlocks/{id} { allow read: if true; allow write: if false; }
    // spaceReports ve spaceRatings anonim uid içerir; istemciye kapalıdır, API uid'siz özet döndürür.

    match /{document=**} { allow read, write: if false; }
  }
}
