# `next dev` için yerel varsayılanlar: Firebase Emulator + örnek veri. Gizli DEĞİLDİR (sahte demo değerleri).
# Gerçek bir Firebase projesine bağlanmak için .env.local oluştur; oradaki değerler bunların önüne geçer.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sau-calisma.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sau-calisma
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_USE_EMULATOR=true
DEMO_MODE=true
